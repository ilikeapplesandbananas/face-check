# PostgreSQL
POSTGRES_DB=veriface
POSTGRES_USER=veriface
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432

# Qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Application services
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Face-inference models (Step 2)
# Download the ONNX files from your approved InsightFace model distribution and
# place them in backend/models. Do not commit these large model artifacts.
VERIFACE_RETINAFACE_MODEL_PATH=models/retinaface_r50_v1.onnx
VERIFACE_ARCFACE_MODEL_PATH=models/arcface_r100_v1.onnx
VERIFACE_ONNX_PROVIDERS=CPUExecutionProvider
VERIFACE_BLUR_THRESHOLD=100.0
VERIFACE_MIN_FACE_SIZE=112

# Database and vector index (Step 3)
VERIFACE_DATABASE_URL=postgresql+psycopg://veriface:change-me-before-production@localhost:5432/veriface
VERIFACE_QDRANT_URL=http://localhost:6333
VERIFACE_QDRANT_COLLECTION=face_embeddings
VERIFACE_MAX_UPLOAD_BYTES=10485760
